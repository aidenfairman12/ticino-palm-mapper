__pycache__/
*.pyc
.ipynb_checkpoints/
.env

# virtual environments
.venv/
venv/
env/

# node (deck/report build tooling)
node_modules/

# OS / editor cruft
.DS_Store
*.swp
.idea/
.vscode/

# data is large / licensed — don't commit it
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
# EXCEPTION: hand-verified ground truth is irreplaceable analyst work, not
# regenerable/licensed bulk data — track it like code. A directory excluded
# above is pruned during traversal, so it must be un-ignored explicitly
# before per-file exceptions inside it will be honoured.
!data/interim/labels/
data/interim/labels/*
!data/interim/labels/*_hand_verified.csv
!data/interim/labels/*_confirmed_palms.geojson
# model checkpoints
*.pt
*.ckpt

# full-grid scoring output — regenerable (sbatch slurm/score_and_review_full.sbatch),
# hundreds of thousands of rows, exceeds GitHub's 100MB file size limit
candidate_scores_full.geojson

# built containers / job logs
*.sif
logs/
